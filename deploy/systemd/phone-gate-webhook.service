[Unit]
Description=Phone Gate Bridge Twilio Webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gatebridge
Group=gatebridge
WorkingDirectory=/opt/phone-gate-bridge
EnvironmentFile=/etc/phone-gate-bridge/phone-gate-bridge.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/phone-gate-bridge/deploy/validate-env.sh /etc/phone-gate-bridge/phone-gate-bridge.env
ExecStart=/opt/phone-gate-bridge/.venv/bin/gate-webhook
Restart=on-failure
RestartSec=2
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=phone-gate-bridge
StateDirectoryMode=0750
ReadWritePaths=/var/lib/phone-gate-bridge
# Compatibility for existing installs whose env still uses var/activity.sqlite3.
ReadWritePaths=-/opt/phone-gate-bridge/var
CapabilityBoundingSet=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
